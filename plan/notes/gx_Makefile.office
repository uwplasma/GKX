# Makefile for GX on the office workstation (pop-os, 2x RTX A4000 sm_86)
# Recreates the validated bc2fe552-era build stack recorded in GKX
# benchmarks/capability_matrix.toml: system CUDA 11.5 nvcc + gcc-10.4.0 host
# compiler + isolated local OpenMPI 4.1.6 / netCDF-c 4.9.2 / HDF5 1.14.5 /
# cuTENSOR 1.7.0.1 / NCCL 2.18.1 / GSL 2.7.1 under ~/local/install.
# NOTE: flags intentionally match the previous office build (-use_fast_math,
# no -prec-sqrt=true), NOT Makefile.ubuntu which adds -prec-sqrt=true.

LOCAL = /home/rjorge/local/install

NETCDF_ROOT   = $(LOCAL)/netcdf-c-4.9.2
HDF5_ROOT     = $(LOCAL)/hdf5-1.14.5
MPI_ROOT      = $(LOCAL)/openmpi-4.1.6
GSL_ROOT      = $(LOCAL)/gsl-2.7.1
CUTENSOR_ROOT = $(LOCAL)/libcutensor-1.7.0.1
NCCL_ROOT     = $(LOCAL)/nccl-2.18.1
GCC10         = $(LOCAL)/gcc-10.4.0

NETCDF_INC = -I $(NETCDF_ROOT)/include
NETCDF_LIB = -L $(NETCDF_ROOT)/lib -Wl,-rpath,$(NETCDF_ROOT)/lib -lnetcdf \
             -L $(HDF5_ROOT)/lib -Wl,-rpath,$(HDF5_ROOT)/lib -lhdf5

MPI_INC = -I $(MPI_ROOT)/include
MPI_LIB = -L $(MPI_ROOT)/lib -Wl,-rpath,$(MPI_ROOT)/lib -lmpi

GSL_INC = -I $(GSL_ROOT)/include
GSL_LIB = -L $(GSL_ROOT)/lib -Wl,-rpath,$(GSL_ROOT)/lib -lgsl -lgslcblas

CUDAARCH = 86
CUDA_INC = -I $(CUTENSOR_ROOT)/include -I $(NCCL_ROOT)/include
CUDA_LIB = -L /usr/lib/x86_64-linux-gnu -lcufft_static -lculibos -lcublas -lcusolver \
           -L $(CUTENSOR_ROOT)/lib/11 -Wl,-rpath,$(CUTENSOR_ROOT)/lib/11 -lcutensor \
           -L $(NCCL_ROOT)/lib -Wl,-rpath,$(NCCL_ROOT)/lib -lnccl -lcudart

C_LIB = -lm -lpthread -ldl

CXX  = $(GCC10)/bin/g++
NVCC = /usr/bin/nvcc
CFLAGS = -fPIC --std=c++17
NVCCFLAGS = -ccbin $(CXX) --std=c++17 --forward-unknown-to-host-compiler \
            -arch=compute_$(CUDAARCH) -code=sm_$(CUDAARCH) \
            -use_fast_math -fPIC -rdc=true

ifeq ($(debug),on)
  NVCCFLAGS += -g -G
else
  NVCCFLAGS += -O3
endif
